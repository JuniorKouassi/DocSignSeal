{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docsignseal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "docsignseal" }
  ],

  // OpenNext's own ISR/data cache, distinct from the document-storage bucket
  // (S3-compatible, lib/storage/s3.ts) the app manages itself. Create this
  // bucket (`wrangler r2 bucket create <name>`) and put its name here.
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "docsignseal-cache" }
  ],

  // The PDF-page render service and Gotenberg are NOT Cloudflare bindings:
  // Cloudflare Containers currently has an unresolved platform bug pushing
  // container images (401 Unauthorized even with correctly-scoped tokens --
  // cloudflare/workers-sdk#12483, affecting many unrelated users). Both run
  // on Render instead and are reached over plain HTTPS -- see
  // lib/render/client.ts, lib/gotenberg/client.ts, and RENDER_SERVICE_URL/
  // RENDER_SERVICE_KEY/GOTENBERG_URL/GOTENBERG_USERNAME/GOTENBERG_PASSWORD
  // in .env.example.
  "images": { "binding": "IMAGES" }
}
