{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docsignseal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // CONTAINERS_WORKER: the two Cloudflare Containers (PDF-page rendering,
  // Gotenberg) live in the separate containers/worker/ project, not here.
  // opennextjs-cloudflare's deploy command has an unresolved bug
  // (opennextjs/opennextjs-cloudflare#952) when Container bindings are
  // defined directly in this app's own wrangler.jsonc -- an ordinary
  // service binding to a plain (non-OpenNext) Worker sidesteps it
  // entirely. See lib/render/client.ts and lib/gotenberg/client.ts.
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "docsignseal" },
    { "binding": "CONTAINERS_WORKER", "service": "docsignseal-containers" }
  ],

  // OpenNext's own ISR/data cache, distinct from the document-storage bucket
  // (S3-compatible, lib/storage/s3.ts) the app manages itself. Create this
  // bucket (`wrangler r2 bucket create <name>`) and put its name here.
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "docsignseal-cache" }
  ],

  "images": { "binding": "IMAGES" }
}
