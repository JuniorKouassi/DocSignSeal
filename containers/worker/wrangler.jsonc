{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docsignseal-containers",
  "main": "./src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Deployed as a plain Worker (no OpenNext involved at all) specifically to
  // work around opennextjs-cloudflare/opennextjs-cloudflare#952: putting
  // Container bindings directly in the OpenNext-generated app's own
  // wrangler.jsonc hits an unresolved "Build ID should be set if containers
  // are defined and enabled" assertion during `opennextjs-cloudflare
  // deploy`. This worker is unaffected since it never goes through that
  // code path -- the main app reaches it via an ordinary service binding
  // (see ../../wrangler.jsonc's `services`).
  "containers": [
    {
      "class_name": "RenderContainer",
      "image": "../render-service/Dockerfile",
      "max_instances": 2
    },
    {
      "class_name": "GotenbergContainer",
      "image": "docker.io/gotenberg/gotenberg:8.15",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RENDER_CONTAINER", "class_name": "RenderContainer" },
      { "name": "GOTENBERG_CONTAINER", "class_name": "GotenbergContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RenderContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["GotenbergContainer"] }
  ]
}
