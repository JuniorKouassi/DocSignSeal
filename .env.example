# Copy this file to .env.local for `next dev`, or to .dev.vars for
# `opennextjs-cloudflare preview` / local Cloudflare-flavored dev -- both
# read the same KEY=value format. In production these become Worker
# secrets (`wrangler secret put NAME`), not a committed file.

# Neon Postgres connection string (pooled). https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Envelope encryption master key for files at rest. Generate with:
#   openssl rand -hex 32
FILE_ENCRYPTION_MASTER_KEY=

# S3-compatible object storage. Works against Cloudflare R2 or AWS S3.
# For R2: set S3_ENDPOINT to https://<account_id>.r2.cloudflarestorage.com
# For AWS S3: leave S3_ENDPOINT unset and set S3_REGION to a real region (e.g. eu-central-1)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=

# Resend (signer invitation emails). https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="DocSignSeal <noreply@yourdomain.com>"

# Base URL used to build signing links in emails. No trailing slash.
APP_URL=http://localhost:3000

# PDF-page render service (containers/render-service/), deployed on Render
# as its own web service -- plain HTTPS, not a Cloudflare binding (Cloudflare
# Containers currently has an unresolved bug pushing container images).
# RENDER_SERVICE_URL is the URL Render gives that service; RENDER_SERVICE_KEY
# is a shared secret you invent -- set the SAME value as that service's own
# RENDER_SERVICE_KEY env var on Render, since it checks every request for it.
RENDER_SERVICE_URL=
RENDER_SERVICE_KEY=

# Gotenberg, also deployed on Render (the official gotenberg/gotenberg image
# directly, no Dockerfile of our own). Pick any username/password -- this
# app builds the Basic Auth header it sends with these; Gotenberg's own
# Render service needs the SAME two values as its
# API_ENABLE_BASIC_AUTH/GOTENBERG_API_BASIC_AUTH_USERNAME/PASSWORD env vars
# so the credentials actually match.
GOTENBERG_URL=
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=
